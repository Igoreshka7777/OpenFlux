#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_failed() {
 /usr/libexec/openflux-network cleanup
 printf '%s\n' '{"state":"error","tx":0,"rx":0}' > /var/run/openflux/status.json
 cat /var/run/openflux/start-error >> /var/run/openflux/client.log
 return 1
}

start_service() {
	[ "$(uci -q get openflux.main.enabled)" = 1 ] || return 0
	mkdir -p /var/run/openflux
 /usr/bin/openflux-client --check 2>/var/run/openflux/start-error || { start_failed; return 1; }
 /usr/libexec/openflux-network prepare 2>/var/run/openflux/start-error || { start_failed; return 1; }
 rm -f /var/run/openflux/start-error
	procd_open_instance
	procd_set_param command /usr/bin/openflux-client
	procd_set_param respawn 3600 15 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_set_param term_timeout 20
	procd_close_instance
}

stop_service() {
	/usr/libexec/openflux-network direct
}

service_stopped() {
	/usr/libexec/openflux-network cleanup
	mkdir -p /var/run/openflux
	printf '%s\n' '{"state":"stopped","tx":0,"rx":0}' > /var/run/openflux/status.json
}

service_triggers() {
	procd_add_reload_trigger openflux
}
